# Main Feed for standard project dependencies
registry=https://pkgs.dev.azure.com/YOUR_ORG/YOUR_PROJECT/_packaging/MAIN_FEED/npm/registry/

# Actual Feed for @mycompany packages
@mycompany:registry=https://pkgs.dev.azure.com/YOUR_ORG/YOUR_PROJECT/_packaging/ACTUAL_AI_FEED_NAME/npm/registry/

always-auth=true
